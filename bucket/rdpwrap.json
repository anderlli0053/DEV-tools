{
    "homepage": "https://github.com/sebaxakerhtc/rdpwrap",
    "description": "sebaxakerhtc 维护的 RDP Wrapper，可以自动下载最新的 rdpwrap.ini，开箱即用。安装需要管理员权限。",
    "license": "Apache-2.0",
    "version": "1.8.9.9",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sebaxakerhtc/rdpwrap/releases/download/v1.8.9.9/RDPW_installer.exe",
            "hash": "932bcf6c68e34fb99ffafb5ae62a1473fe761d961034cb5630dc3a9ba9155ccb"
        }
    },
    "pre_install": [
        "if (!(is_admin)) { error 'Administrator rights are required to install $app.'; exit 1 }",
        "try { SCHTASKS /DELETE /TN RDPWUpdater /F 2>$null } catch {}"
    ],
    "installer": {
        "script": "Start-Process -FilePath \"$dir\\RDPW_installer.exe\" -ArgumentList '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART' -Wait"
    },
    "checkver": {
        "github": "https://github.com/sebaxakerhtc/rdpwrap",
        "regex": "tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sebaxakerhtc/rdpwrap/releases/download/v$version/RDPW_installer.exe"
            }
        }
    }
}
