        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ajwejqdawduhiodkcspxd7whby_153.0.8009.3/153.0.8009.3_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "0a480a5bc0c86da39a6b1a1d3534e611e62db153f2f674b7af93dcd991f61551"
