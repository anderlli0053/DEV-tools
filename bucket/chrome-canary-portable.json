            "hash": "cdbbe7e3cba1889e14390ce29279ae7b1577750a272e6bd6bfb3b3a5c17dc54e"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/braufpiaerg75q5kqjlcpnkcei_153.0.7984.1/153.0.7984.1_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "6e738d66c3882713fb6b0f78e32e1d8627e3b4d661c147ca8b723735a58e5418"
