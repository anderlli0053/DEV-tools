        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/htmz3ru2brex5onrqiqskgisz4_157.0.8090.0/157.0.8090.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "d862e161d97bb176e4f8023ece7c179a7faba8aadb46fa224684a68e249d573e"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acvvs4h7vpfqgdzp7zeqk7ahzqja_157.0.8090.0/157.0.8090.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "ceb1960c302557e3631ac4bc265ca7319652e0698d67f056bbe70b2954636fab"
