            "hash": "935e230ddc0efa84b9b38cb94d64445d0685e84a4cb42f6707e9a6f6412ee2e7"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/fcqnww4uibrohtsbohfxua3jsa_158.0.8116.0/158.0.8116.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "749e7a0c3b76a4e6b145832266e224dc1e763c3ebab8c121c87734fd8981a3d1"
