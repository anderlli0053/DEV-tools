        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ad2gmsohgnh4xyr4txjoqaa45qgq_160.0.8168.4/160.0.8168.4_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "54a09da0c0de858fb8cea3162df8129a41779cd9c822bc1b3f8dc4b1798d5482"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acm57qt6tbxe4n3geje25cuvo63q_160.0.8169.0/160.0.8169.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "84aea9c2dfa55c481724d58e9f9ba68675d0a349b2f64196eb7f8cf9273a834d"
