        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/accnqnvaeghewi5p4iko5wu4z2ca_160.0.8180.0/160.0.8180.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "b920246784851c9e60046313f6377c9eab10eabc55cb9acfcdc6753f15e546bc"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adtbpccx7nefi6bfxqiq6dud7fua_160.0.8180.0/160.0.8180.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "3b088817557b322575cbea1f5d495eab400a288d2cacafaa88427e3d6bfeebed"
