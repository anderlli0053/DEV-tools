            "hash": "609b78ad5e00347e691044f7539e44ef9a6a235396febb592da838bd66c1da1d"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/acus2qohuvnkklmtjvqz3c3h2pxq_158.0.8124.0/158.0.8124.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "44c18602608187d0347cfc206c1abe9fe2a53cb6db85f85c31a4651fd97ce26c"
