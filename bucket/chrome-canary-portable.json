        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/fb24toyzwcncfvanvnrcgnmc4m_153.0.8006.0/153.0.8006.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "769da3f51a8b28a5ecfa74d69ee43c3df0848d2937d851522eded13c3a33ddb5"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/oe2asncmayq77n7qlwrkzp7xwu_153.0.8006.0/153.0.8006.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "d744fa20fa41de6587bcfd8877aaa4ea9178adaab6676bfdcfc360284b001ff1"
