        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/emac5smjeojoernifcsdqwjyxe_154.0.8032.0/154.0.8032.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "c4db461992162b9d932bb89e33ddec7aba1217db59ad34d8c783173bbbfb67ad"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad4igkyzo325ex3bfmivka3yxx2a_154.0.8032.0/154.0.8032.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "6ffe1796cbaa7c25a22348e1c4bf4fc99c831e3545bceaaf26d6e61616019885"
