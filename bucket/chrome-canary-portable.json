            "hash": "629484902a55653c942367e96561d184726aa9821bfcf7245158603351c2a616"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/e6s77nxfpygqavmpjilt3pzwbm_160.0.8181.0/160.0.8181.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "e9f2a19e5362444b3b6c6e7c16164b80dcc9611fdce89e2f5684e0434cc30ab6"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/cxvu3ebfv4ancmmcxnplki355e_160.0.8181.0/160.0.8181.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "ac14304acb09687ba1830f5569a1155fb0661e778ccd5d354a9634e464e01aff"
        }
