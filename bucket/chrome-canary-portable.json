            "hash": "0cc8efc3e85daa216f05cbdc7fc7eeae9e698f44f13cf3e565df20eb3761f492"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/lab637lwl342n7p72p54a7udou_160.0.8166.0/160.0.8166.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "35a226bbbe239588c2206970249f5822bc97d0bd11fc758d728bbdc56f0c2a17"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ad6x6rsp2ywuee26m5ullvaeudja_160.0.8166.0/160.0.8166.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "302b726cb1b9f94aa31fc88861d117bc6a82cd1dab32d0f6db10f75a07178a05"
