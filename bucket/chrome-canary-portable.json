        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/acfyj4x3lhimusqthw75qm5skwnq_160.0.8173.0/160.0.8173.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "5f89da09e714732efa34140fd84932f72665da3aab04f450308aa137eb263463"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adzmanmh7lbfllpbilhdqd732fyq_160.0.8173.0/160.0.8173.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "6adb162b98ab17f117fd2f8762d7c92394ce532429f8d2b40de4d2a0e402788a"
