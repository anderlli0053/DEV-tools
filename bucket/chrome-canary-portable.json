        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/capfpph3kdf44w4zvdb6uiw5nu_158.0.8106.0/158.0.8106.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "f62df218fd95bc00d3827c0e2e68a48725120e2c765b6f906d45d0cdd22c3415"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/ov3g2o4b527cnbocb27o27sxji_158.0.8106.0/158.0.8106.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "e7edd1600c7aec6d274cbd22a1f7c4ca73720409aa9b262f50123896443fb6c3"
