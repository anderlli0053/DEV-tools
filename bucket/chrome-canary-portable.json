            "hash": "cbb4ace61911b26c083c69e49cecd2ed000d3e372003183ca502344e300b6e3c"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/pfebuokotd6csyspzoi335hd34_157.0.8093.1/157.0.8093.1_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "22e72866d1966b6e2eb51e7703572de7c3f11424b59fdb616e4ad59ce6541d8a"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/adiokc6anoupyvk7bqpxcrxlksxq_157.0.8093.0/157.0.8093.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "4b50954a36207f73c69f9967e7003eaff311400e6a88e00ae988bbd4ce71413d"
