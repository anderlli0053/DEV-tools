            "hash": "25c57627bbf321b9204fc9bff227aed9421e65aff4518bd5c0774d569b8c9a23",
            "extract_dir": "win-x64"
        },
        "32bit": {
            "url": "https://github.com/RayWangQvQ/BiliBiliToolPro/releases/download/4.0.6/bilibili-tool-pro-v4.0.6-win-x86.zip",
            "hash": "bbbf65880a61d00fd265253791acbc52f5b795e0f92125328b47ebf140dbcd09",
